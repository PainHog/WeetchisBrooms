{
  "name": "witch-ward",
  "version": "0.9.0",
  "description": "Witch & Ward — a tabletop roleplaying game by Richard Moore: rulebook pipeline, Foundry VTT system and rules simulator.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packs": "node tools/build-packs.mjs",
    "clean:packs": "node tools/build-packs.mjs --clean",
    "validate": "node tools/validate.mjs",
    "test": "node --test \"test/**/*.test.mjs\" \"sim/**/*.test.mjs\"",
    "check": "npm run validate && npm test",
    "build:book": "node book/build.mjs",
    "sim": "node sim/run.mjs"
  },
  "devDependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "handlebars": "^4.7.9",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.56.1"
  }
}
